NODE_ENV=production
PORT=4000
GROQ_API_KEY=your_groq_api_key
ADMIN_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_USER=admin_username
ADMIN_PASS_HASH=admin_bcrypt_hash
ADMIN_TOTP_SECRET=totp_secret
OMI_KML_PATH=/app/omi

# Geoapify — ricerca/reverse indirizzi (opzionale: se assente si usa solo
# Nominatim/Photon). Chiave gratuita su https://myprojects.geoapify.com
GEOAPIFY_API_KEY=your_geoapify_api_key
VITE_API_BASE_URL=http://localhost:4001/api
VITE_USE_MOCKS=false

# Better Auth
BETTER_AUTH_SECRET=generate_with_openssl_rand_hex_32
APP_BASE_URL=http://localhost:4001
APP_FRONTEND_URL=http://localhost:5173

# listmonk + PostgreSQL (Fase 2)
LISTMONK_URL=http://localhost:9000
LISTMONK_USERNAME=admin
LISTMONK_PASSWORD=your_listmonk_password
LISTMONK_db__host=localhost
LISTMONK_db__port=5432
LISTMONK_db__user=listmonk
LISTMONK_db__password=your_postgres_password
LISTMONK_db__database=listmonk
LISTMONK_app__admin_username=admin
LISTMONK_app__admin_password=your_listmonk_password
LISTMONK_app__address=0.0.0.0:9000
LISTMONK_TEMPLATE_WELCOME=1
LISTMONK_TEMPLATE_REPORT_PAGAMENTO=2
LISTMONK_TEMPLATE_MAGIC_LINK=3
LISTMONK_TEMPLATE_VISURA_PRONTA=4
LISTMONK_LIST_TUTTI_UTENTI=1
LISTMONK_LIST_CLIENTI_PAGANTI=2
LISTMONK_LIST_UTENTI_FREE=3
LISTMONK_LIST_NEWSLETTER=4

# Stripe (Fase 3)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# AdSense Offerwall (Fase 6) — opzionale, in dev usa countdown simulato
VITE_ADSENSE_PUBLISHER_ID=
VITE_ADSENSE_AD_UNIT=
